#!/bin/sh
# Connectivity watchdog for rm520n — runs as a procd-managed daemon.
# Polls the configured host every <interval> seconds. On <threshold> consecutive
# failures triggers the configured action. Cascade mode: reconnect first,
# then escalates to reboot_modem if reconnect did not restore connectivity.

FAIL_FILE="/tmp/rm520n_watchdog_fails"
RECONNECT_FLAG="/tmp/.rm520n_reconnected"

_cfg() { uci -q get "rm520n.watchdog.$1" 2>/dev/null; }

_trigger_reconnect() {
    logger -t rm520n-watchdog "threshold reached — triggering: reconnect"
    touch "$RECONNECT_FLAG"
    rm -f "$FAIL_FILE"
    ubus call rm520n reconnect
    sleep 30
}

_trigger_reboot() {
    logger -t rm520n-watchdog "threshold reached — triggering: reboot_modem"
    rm -f "$RECONNECT_FLAG" "$FAIL_FILE"
    ubus call rm520n reboot_modem
    sleep 60
}

while true; do
    [ -f /etc/config/rm520n ] || { sleep 30; continue; }

    enabled="$(_cfg enabled)"; [ "$enabled" = "1" ] || { sleep 30; continue; }

    host="$(_cfg ping_host)";        host="${host:-8.8.8.8}"
    threshold="$(_cfg fail_threshold)"; threshold="${threshold:-3}"
    action="$(_cfg action)";         action="${action:-reboot_modem}"
    interval="$(_cfg interval)";     interval="${interval:-10}"

    if ping -c 2 -W 3 "$host" > /dev/null 2>&1; then
        rm -f "$FAIL_FILE" "$RECONNECT_FLAG"
        sleep "$interval"
        continue
    fi

    fails="$(cat "$FAIL_FILE" 2>/dev/null)"
    fails=$(( ${fails:-0} + 1 ))
    printf '%d' "$fails" > "$FAIL_FILE"
    logger -t rm520n-watchdog "ping $host failed ($fails/$threshold)"

    if [ "$fails" -lt "$threshold" ]; then
        sleep "$interval"
        continue
    fi

    case "$action" in
        cascade)
            if [ -f "$RECONNECT_FLAG" ]; then
                logger -t rm520n-watchdog "reconnect was ineffective — escalating"
                rm -f "$RECONNECT_FLAG"
                _trigger_reboot
            else
                _trigger_reconnect
            fi
            ;;
        reboot_modem)
            _trigger_reboot
            ;;
        reconnect)
            _trigger_reconnect
            ;;
    esac
done
