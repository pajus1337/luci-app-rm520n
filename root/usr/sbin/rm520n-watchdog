#!/bin/sh
# Connectivity watchdog for rm520n - runs as a procd-managed daemon.
# Polls the configured host every <interval> seconds. On <threshold> consecutive
# failures triggers the configured action. Cascade mode escalates in three
# stages: reconnect -> reboot_modem -> reboot_router, one stage per threshold
# hit, as long as connectivity keeps failing.
#
# Every failed check is classified (gateway down, no route, mobile data down,
# or only the primary host unreachable) and incidents, recovery actions and
# serving cell changes are written to an event log for the Tools page.

FAIL_FILE="/tmp/rm520n_watchdog_fails"
STAGE_FILE="/tmp/rm520n_watchdog_stage"
LAST_OK_FILE="/tmp/rm520n_watchdog_last_ok"
COUNTERS_FILE="/tmp/rm520n_watchdog_counters"
NO_MODEM_FILE="/tmp/rm520n_watchdog_no_modem"
EVENTS_MAX=300
CELL_EVERY=60

_cfg() { uci -q get "rm520n.watchdog.$1" 2>/dev/null; }

# One-line signal snapshot taken via the existing rpcd refresh() call, so
# every logged action carries the connection state that led to it - makes
# the history log useful for diagnosing whether failures correlate with
# poor signal, PSU quality, traffic load, or NR SCC state.
_signal_snapshot() {
    local raw tech rsrp sinr rrc mv tx rx prev_tx prev_rx dtx drx
    local i type band crsrp scc

    raw="$(ubus call rm520n refresh 2>/dev/null)"
    if [ -z "$raw" ]; then
        printf 'signal=unavailable'
        return
    fi
    tech="$(printf '%s' "$raw" | jsonfilter -e '@.technology' 2>/dev/null)"
    rsrp="$(printf '%s' "$raw" | jsonfilter -e '@.rsrp'       2>/dev/null)"
    sinr="$(printf '%s' "$raw" | jsonfilter -e '@.sinr'       2>/dev/null)"
    rrc="$( printf '%s' "$raw" | jsonfilter -e '@.rrc_state'  2>/dev/null)"
    mv="$(  printf '%s' "$raw" | jsonfilter -e '@.supply_mv'  2>/dev/null)"
    tx="$(  printf '%s' "$raw" | jsonfilter -e '@.modem_tx'   2>/dev/null)"
    rx="$(  printf '%s' "$raw" | jsonfilter -e '@.modem_rx'   2>/dev/null)"

    dtx="?"; drx="?"
    if [ -n "$tx" ] && [ -n "$rx" ]; then
        [ -f "$COUNTERS_FILE" ] && read -r prev_tx prev_rx < "$COUNTERS_FILE"
        [ -n "$prev_tx" ] && [ -n "$prev_rx" ] && dtx=$(( tx - prev_tx )) && drx=$(( rx - prev_rx ))
        printf '%s %s' "$tx" "$rx" > "$COUNTERS_FILE"
    fi

    scc=""
    i=0
    while [ "$i" -lt 8 ]; do
        type="$(printf '%s' "$raw" | jsonfilter -e "@.ca[$i].type" 2>/dev/null)"
        [ -z "$type" ] && break
        if [ "$type" = "SCC" ]; then
            band="$( printf '%s' "$raw" | jsonfilter -e "@.ca[$i].band" 2>/dev/null)"
            crsrp="$(printf '%s' "$raw" | jsonfilter -e "@.ca[$i].rsrp" 2>/dev/null)"
            if [ -n "$crsrp" ]; then
                scc="${scc}b${band:-?}:${crsrp}dBm,"
            else
                scc="${scc}b${band:-?}:null,"
            fi
        fi
        i=$(( i + 1 ))
    done
    scc="${scc%,}"; scc="${scc:-none}"

    printf 'tech=%s rsrp=%sdBm sinr=%sdB rrc=%s mv=%smV tx+=%sB rx+=%sB scc=%s gw=%s' \
        "${tech:-?}" "${rsrp:-?}" "${sinr:-?}" "${rrc:-?}" "${mv:-?}" "$dtx" "$drx" "$scc" "$(_gw_ping)"
}

# Reachability of the local next hop, independent of the target host - lets a
# logged snapshot distinguish "modem/board unreachable" from "operator/WAN
# down but the local link is fine". Uses the live default route so this stays
# correct regardless of how the modem's data path is set up on a given router.
_gw_ping() {
    local gw
    gw="$(ip route show default 2>/dev/null | awk '{print $3; exit}')"
    [ -z "$gw" ] && { printf 'unknown'; return; }
    ping -c 1 -W 2 "$gw" >/dev/null 2>&1 && printf 'up' || printf 'down'
}

# Polls for connectivity recovery instead of blindly sleeping for the worst
# case: checks the WAN interface is up and a ping succeeds, every 3s up to
# max_wait seconds. Resumes as soon as recovery is confirmed and logs the
# measured recovery time either way, so the fixed cap only ever bounds
# duration - it no longer dictates it.
_wait_for_recovery() {
    local max_wait="$1" host="$2" start elapsed wan_up
    start="$(date +%s)"
    while :; do
        sleep 3
        wan_up="$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null)"
        if [ "$wan_up" = "true" ] && ping -c 1 -W 3 "$host" > /dev/null 2>&1; then
            logger -t rm520n-watchdog "connectivity recovered after ~$(( $(date +%s) - start ))s"
            return 0
        fi
        elapsed=$(( $(date +%s) - start ))
        [ "$elapsed" -ge "$max_wait" ] && break
    done
    logger -t rm520n-watchdog "connectivity not confirmed within ${max_wait}s cap (waited ${elapsed}s)"
}

# Every action, reboot_router included, is only useful while the modem can be
# managed. Without an AT port (e.g. serial kmods missing after a stock firmware
# upgrade) a router reboot cannot bring it back and would loop forever.
_modem_ready() {
    local p
    ubus list rm520n >/dev/null 2>&1 || return 1
    for p in /dev/ttyUSB2 /dev/ttyUSB3 /dev/ttyUSB1 /dev/ttyUSB0; do
        [ -c "$p" ] && return 0
    done
    return 1
}

_event() {
    printf '%s %s\n' "$(date +%s)" "$*" >> "$EVENTS"
    if [ "$(wc -l < "$EVENTS")" -gt "$EVENTS_MAX" ]; then
        tail -n "$EVENTS_MAX" "$EVENTS" > "$EVENTS.tmp" && mv "$EVENTS.tmp" "$EVENTS"
    fi
}

# Sets cell_sig (the primary serving cell) and cell_signal from one rpcd
# refresh() call. SCCs are left out of cell_sig because they come and go with
# RRC state and traffic. Returns 1 if the modem did not answer.
_cell_state() {
    local raw tech band pci cell rsrp sinr sccb sccp b scc=""
    raw="$(ubus call rm520n refresh 2>/dev/null)"
    [ -z "$raw" ] && return 1
    eval "$(printf '%s' "$raw" | jsonfilter -e 'tech=@.technology' -e 'band=@.band' \
        -e 'pci=@.pci' -e 'cell=@.cell_id' -e 'rsrp=@.rsrp' -e 'sinr=@.sinr' \
        -e 'sccb=@.ca[@.type="SCC"].band' -e 'sccp=@.ca[@.type="SCC"].pci' 2>/dev/null)"
    set -- $sccp
    for b in $sccb; do
        scc="${scc}${scc:+,}b${b}/${1:-?}"
        shift
    done
    cell_sig="tech=${tech:-?} band=${band:-?} pci=${pci:-?} cell=${cell:-?}"
    cell_signal="scc=${scc:-none} rsrp=${rsrp:-?} sinr=${sinr:-?}"
}

_check_cell() {
    _cell_state || return
    [ "$cell_sig" = "$last_cell" ] && return
    _event "cell $cell_sig $cell_signal"
    last_cell="$cell_sig"
}

_classify_failure() {
    case "$(_gw_ping)" in
        down)    printf 'modem_unreachable' ;;
        unknown) printf 'no_route' ;;
        *)       ping -c 1 -W 3 "$host2" > /dev/null 2>&1 && printf 'target_only' || printf 'wwan_down' ;;
    esac
}

# $2 is when the check started, so durations are not shortened by the time
# a failing ping spends waiting for its timeouts.
_track_incident() {
    local v="$1" now="$2"
    [ "$v" = "ok" ] && v=""
    [ "$v" = "$incident" ] && return
    if [ -n "$incident" ]; then
        _event "incident_end verdict=$incident duration=$(( now - incident_start ))"
        logger -t rm520n-watchdog "incident ended: $incident after $(( now - incident_start ))s"
    fi
    incident="$v"
    incident_start="$now"
    [ -z "$v" ] && return
    _cell_state || { cell_sig="modem=unavailable"; cell_signal=""; }
    _event "incident_start verdict=$v $cell_sig $cell_signal"
    logger -t rm520n-watchdog "incident started: $v"
}

_trigger_reconnect() {
    _event "action name=reconnect"
    logger -t rm520n-watchdog "threshold reached - action: reconnect [$(_signal_snapshot)]"
    printf '1' > "$STAGE_FILE"
    rm -f "$FAIL_FILE"
    ubus call rm520n reconnect
    _wait_for_recovery 30 "$host"
}

_trigger_reboot_modem() {
    _event "action name=reboot_modem"
    logger -t rm520n-watchdog "threshold reached - action: reboot_modem [$(_signal_snapshot)]"
    printf '2' > "$STAGE_FILE"
    rm -f "$FAIL_FILE"
    ubus call rm520n reboot_modem
    # AT+CFUN=1,1 resets the modem's own byte counters (AT+QGDCNT), so the
    # next _signal_snapshot() must not diff against pre-reboot values -
    # that produced nonsensical negative tx+/rx+ deltas across the reset.
    rm -f "$COUNTERS_FILE"
    _wait_for_recovery 60 "$host"
}

_trigger_reboot_router() {
    _event "action name=reboot_router"
    logger -t rm520n-watchdog "threshold reached - action: reboot_router (full system reboot) [$(_signal_snapshot)]"
    rm -f "$FAIL_FILE" "$STAGE_FILE"
    sync
    reboot
    # The process is about to be killed by the reboot itself - there is no
    # connectivity left to poll for from here, just a grace period so this
    # loop iteration doesn't race back into another trigger beforehand.
    sleep 120
}

incident=""
incident_start=0
last_cell=""
next_cell=0

while true; do
    [ -f /etc/config/rm520n ] || { sleep 30; continue; }

    enabled="$(_cfg enabled)"; [ "$enabled" = "1" ] || { sleep 30; continue; }

    host="$(_cfg ping_host)";        host="${host:-8.8.8.8}"
    threshold="$(_cfg fail_threshold)"; threshold="${threshold:-3}"
    action="$(_cfg action)";         action="${action:-reboot_modem}"
    interval="$(_cfg interval)";     interval="${interval:-10}"
    host2="$(_cfg ping_host2)";      host2="${host2:-1.1.1.1}"
    log_dir="$(_cfg log_dir)";       EVENTS="${log_dir:-/tmp/rm520n}/events.log"
    mkdir -p "${EVENTS%/*}"

    if [ "$(date +%s)" -ge "$next_cell" ]; then
        _check_cell
        next_cell=$(( $(date +%s) + CELL_EVERY ))
    fi

    check_start="$(date +%s)"
    verdict="ok"
    ping -c 2 -W 3 "$host" > /dev/null 2>&1 || verdict="$(_classify_failure)"
    _track_incident "$verdict" "$check_start"

    # The connection itself works when only the primary host is unreachable,
    # so a recovery action could not fix anything.
    if [ "$verdict" = "ok" ] || [ "$verdict" = "target_only" ]; then
        rm -f "$FAIL_FILE" "$STAGE_FILE"
        date +%s > "$LAST_OK_FILE"
        sleep "$interval"
        continue
    fi

    fails="$(cat "$FAIL_FILE" 2>/dev/null)"
    fails=$(( ${fails:-0} + 1 ))
    printf '%d' "$fails" > "$FAIL_FILE"
    logger -t rm520n-watchdog "ping $host failed ($fails/$threshold, $verdict)"

    if [ "$fails" -lt "$threshold" ] || [ "$action" = "monitor" ]; then
        sleep "$interval"
        continue
    fi

    if ! _modem_ready; then
        if [ ! -f "$NO_MODEM_FILE" ]; then
            logger -t rm520n-watchdog "threshold reached but no modem AT port or rm520n rpcd object - skipping $action, monitoring continues"
            _event "action_skipped reason=no_modem action=$action"
            touch "$NO_MODEM_FILE"
        fi
        rm -f "$FAIL_FILE"
        sleep "$interval"
        continue
    fi
    if [ -f "$NO_MODEM_FILE" ]; then
        logger -t rm520n-watchdog "modem AT port available again - actions re-enabled"
        rm -f "$NO_MODEM_FILE"
    fi

    case "$action" in
        cascade)
            stage="$(cat "$STAGE_FILE" 2>/dev/null)"; stage="${stage:-0}"
            case "$stage" in
                1) logger -t rm520n-watchdog "reconnect was ineffective - escalating"
                   _trigger_reboot_modem ;;
                2) logger -t rm520n-watchdog "reboot_modem was ineffective - escalating"
                   _trigger_reboot_router ;;
                *) _trigger_reconnect ;;
            esac
            ;;
        reboot_modem)
            _trigger_reboot_modem
            ;;
        reconnect)
            _trigger_reconnect
            ;;
        reboot_router)
            _trigger_reboot_router
            ;;
    esac
done
